{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-viewport-poc",
  "version": "0.1.0",
  "identifier": "com.section-properties.tauri-viewport-poc",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tauri Viewport PoC",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
